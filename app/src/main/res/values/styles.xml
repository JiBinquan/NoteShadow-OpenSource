<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F5F5F5</item>
        <item name="android:navigationBarColor">#F5F5F5</item>
        <item name="android:colorAccent">#444444</item>
    </style>

    <style name="GraphiteTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/graphite_background</item>
        <item name="android:statusBarColor">@color/graphite_background</item>
        <item name="android:navigationBarColor">@color/graphite_background</item>
        <item name="android:colorAccent">@color/graphite_primary</item>
        <item name="android:textColorPrimary">@color/graphite_text_primary</item>
        <item name="android:textColorSecondary">@color/graphite_text_secondary</item>
        <item name="android:colorControlNormal">@color/graphite_text_secondary</item>
        <item name="android:colorControlActivated">@color/graphite_primary</item>
    </style>

    <style name="GraphiteButton" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">@color/graphite_primary</item>
        <item name="android:minHeight">@dimen/ui_touch_target</item>
        <item name="android:paddingLeft">@dimen/ui_space_16</item>
        <item name="android:paddingRight">@dimen/ui_space_16</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="GraphitePrimaryButton" parent="GraphiteButton">
        <item name="android:backgroundTint">@color/graphite_primary</item>
        <item name="android:textColor">@color/graphite_surface</item>
    </style>

    <style name="GraphiteCard">
        <item name="android:background">@color/graphite_surface</item>
        <item name="android:padding">@dimen/ui_space_16</item>
    </style>
</resources>
